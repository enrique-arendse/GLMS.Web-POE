@model IEnumerable<GLMS.Web_POE.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests Management - TechMove Logistics";
}

<!-- Page Header -->
<div class="page-header" style="background-image: url('/images/pages/service-banner.png'); background-size: cover; background-position: center 35%; border-radius: 0.75rem; padding: 7rem 2rem; color: white;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h1 class="mb-2" style="color: white !important;">
                <i class="fa-solid fa-tasks me-2"></i>Service Requests Management
            </h1>
            <p class="mb-0" style="color: rgba(255,255,255,0.85) !important;">
                Track shipments, manage invoicing, and monitor request status with real-time currency conversion.
            </p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-plus me-2"></i>New Request
        </a>
    </div>
</div>

<!-- Quick Filters -->
<div class="card mb-4 border-0">
    <div class="card-body">
        <div class="d-flex gap-3 flex-wrap">
            <div class="filter-badge">
                <span class="badge bg-primary p-2">
                    <i class="fa-solid fa-hourglass-start me-2"></i>Pending Requests
                </span>
            </div>
            <div class="filter-badge">
                <span class="badge bg-info p-2">
                    <i class="fa-solid fa-spinner me-2"></i>In Progress
                </span>
            </div>
            <div class="filter-badge">
                <span class="badge bg-success p-2">
                    <i class="fa-solid fa-check-circle me-2"></i>Completed
                </span>
            </div>
            <div class="filter-badge">
                <span class="badge bg-danger p-2">
                    <i class="fa-solid fa-circle-xmark me-2"></i>Rejected
                </span>
            </div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <!-- Service Request Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-number">@Model.Count()</div>
                <div class="stat-label">Total Requests</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-number">@Model.Count(r => r.Status == GLMS.Web_POE.Models.ServiceRequestStatus.Pending)</div>
                <div class="stat-label">Pending</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-number">@Model.Sum(r => r.AmountUsd ?? 0).ToString("C0")</div>
                <div class="stat-label">Total Value (USD)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-number">R @Model.Sum(r => r.Cost).ToString("N0")</div>
                <div class="stat-label">Total Cost (ZAR)</div>
            </div>
        </div>
    </div>

    <!-- Service Requests Table -->
    <div class="card border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="text-start">
                                <i class="fa-solid fa-file-lines me-2"></i>Description & Priority
                            </th>
                            <th class="text-center">
                                <i class="fa-solid fa-box me-2"></i>Contract Level
                            </th>
                            <th class="text-end">
                                <i class="fa-solid fa-dollar-sign me-2"></i>Amount (USD)
                            </th>
                            <th class="text-end">
                                <i class="fa-solid fa-exchange me-2"></i>Exchange Rate
                            </th>
                            <th class="text-end">
                                <i class="fa-solid fa-rand me-2"></i>Cost (ZAR)
                            </th>
                            <th class="text-center">
                                <i class="fa-solid fa-circle-info me-2"></i>Status
                            </th>
                            <th class="text-center">
                                <i class="fa-solid fa-clock me-2"></i>Timeline
                            </th>
                            <th class="text-center" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-start">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-placeholder rounded-circle bg-warning bg-opacity-10 p-2">
                                            <i class="fa-solid fa-clipboard text-warning"></i>
                                        </div>
                                        <div>
                                            <strong>@Html.DisplayFor(modelItem => item.Description)</strong>
                                            <div class="mt-2">
                                                <span class="badge bg-warning p-2">
                                                    <i class="fa-solid fa-flag me-1"></i>Standard
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (item.Contract != null)
                                    {
                                        <span class="badge bg-info">@Html.DisplayFor(modelItem => item.Contract.ServiceLevel)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">N/A</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.AmountUsd.HasValue)
                                    {
                                        <strong class="text-primary">$@item.AmountUsd.Value.ToString("F2")</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.ExchangeRate.HasValue)
                                    {
                                        <small class="text-muted fw-600">@item.ExchangeRate.Value.ToString("F4")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <strong class="text-success">R @item.Cost.ToString("F2")</strong>
                                </td>
                                <td class="text-center">
                                    @{
                                        var statusDisplay = item.Status switch
                                        {
                                            GLMS.Web_POE.Models.ServiceRequestStatus.Pending => (icon: "fa-hourglass-start", badge: "badge-warning", label: "Pending"),
                                            GLMS.Web_POE.Models.ServiceRequestStatus.Approved => (icon: "fa-check", badge: "badge-info", label: "Approved"),
                                            GLMS.Web_POE.Models.ServiceRequestStatus.InProgress => (icon: "fa-spinner", badge: "badge-primary", label: "In Progress"),
                                            GLMS.Web_POE.Models.ServiceRequestStatus.Completed => (icon: "fa-check-circle", badge: "badge-success", label: "Completed"),
                                            GLMS.Web_POE.Models.ServiceRequestStatus.Rejected => (icon: "fa-circle-xmark", badge: "badge-danger", label: "Rejected"),
                                            _ => (icon: "fa-question-circle", badge: "badge-muted", label: "Unknown")
                                        };
                                    }
                                    <span class="badge @statusDisplay.badge">
                                        <i class="fa-solid @statusDisplay.icon me-1"></i>@statusDisplay.label
                                    </span>
                                </td>
                                <td class="text-center">
                                    <small class="text-muted">
                                        <i class="fa-solid fa-calendar-plus me-1"></i>@Html.DisplayFor(modelItem => item.CreatedAt)
                                    </small>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="View details">
                                            <i class="fa-solid fa-eye me-1"></i>View
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                            <i class="fa-solid fa-pencil me-1"></i>Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="fa-solid fa-trash me-1"></i>Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <small class="text-muted">Showing @Model.Count() service requests</small>
        <nav aria-label="Page navigation">
            <ul class="pagination mb-0">
                <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">Next</a></li>
            </ul>
        </nav>
    </div>
}
else
{
    <!-- Empty State -->
    <div class="alert alert-info border-0 py-5" role="alert">
        <div class="text-center">
            <i class="fa-solid fa-inbox fa-3x text-info mb-3 d-block"></i>
            <h4 class="mb-2">No Service Requests Found</h4>
            <p class="text-muted mb-4">Create your first service request to start tracking shipments and managing invoices.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa-solid fa-plus me-2"></i>Create Your First Request
            </a>
        </div>
    </div>
}
