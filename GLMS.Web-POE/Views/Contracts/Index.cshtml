@model IEnumerable<GLMS.Web_POE.Models.Contract>

@{
    ViewData["Title"] = "Contracts Management - TechMove Logistics";
}

<!-- Page Header -->
<div class="page-header" style="background-image: url('/images/pages/contracts-banner.png'); background-size: cover; background-position: center 35%; border-radius: 0.75rem; padding: 7rem 2rem; color: white;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h1 class="mb-2" style="color: white !important;">
                <i class="fa-solid fa-file-contract me-2"></i>Contracts Management
            </h1>
            <p class="mb-0" style="color: rgba(255,255,255,0.85) !important;">
                Monitor and manage all freight service contracts with expiration tracking and compliance alerts.
            </p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-plus me-2"></i>New Contract
        </a>
    </div>
</div>

<!-- Search & Filter Section -->
<div class="card mb-4 border-0">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            @{
                var currentStatus = ViewData["CurrentStatus"]?.ToString();
            }
            <div class="col-md-3">
                <label for="startDate" class="form-label fw-600">Start Date</label>
                <input type="date" id="startDate" name="startDate" class="form-control" 
                       value="@ViewData["CurrentStartDate"]" />
            </div>
            <div class="col-md-3">
                <label for="endDate" class="form-label fw-600">End Date</label>
                <input type="date" id="endDate" name="endDate" class="form-control" 
                       value="@ViewData["CurrentEndDate"]" />
            </div>
            <div class="col-md-3">
                <label for="status" class="form-label fw-600">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="0" selected="@(currentStatus == "0" ? "selected" : null)">Draft</option>
                    <option value="1" selected="@(currentStatus == "1" ? "selected" : null)">Active</option>
                    <option value="2" selected="@(currentStatus == "2" ? "selected" : null)">Expired</option>
                    <option value="3" selected="@(currentStatus == "3" ? "selected" : null)">On Hold</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="fa-solid fa-search me-2"></i>Search
                    </button>
                    <button type="reset" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-rotate-right"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Contract Stats -->
@if (Model.Any())
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-number">@Model.Count()</div>
                <div class="stat-label">Total Contracts</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-number">@Model.Count(c => c.Status == GLMS.Web_POE.Models.ContractStatus.Active)</div>
                <div class="stat-label">Active</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-number">@Model.Count(c => c.Status == GLMS.Web_POE.Models.ContractStatus.Expired)</div>
                <div class="stat-label">Expired</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-number">@Model.Count(c => c.Status == GLMS.Web_POE.Models.ContractStatus.Draft)</div>
                <div class="stat-label">Drafts</div>
            </div>
        </div>
    </div>
}

<!-- Contracts Table -->
@if (Model.Any())
{
    <div class="card border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="text-start">
                                <i class="fa-solid fa-building me-2"></i>Client & Contract
                            </th>
                            <th class="text-center">
                                <i class="fa-solid fa-calendar me-2"></i>Duration
                            </th>
                            <th class="text-center">
                                <i class="fa-solid fa-tag me-2"></i>Service Level
                            </th>
                            <th class="text-center">
                                <i class="fa-solid fa-circle-info me-2"></i>Status
                            </th>
                            <th class="text-center">
                                <i class="fa-solid fa-file me-2"></i>Agreement
                            </th>
                            <th class="text-center" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-start">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-placeholder rounded-circle bg-success bg-opacity-10 p-2">
                                            <i class="fa-solid fa-file-contract text-success"></i>
                                        </div>
                                        <div>
                                            <strong>@Html.DisplayFor(modelItem => item.Client.Name)</strong><br/>
                                            <small class="text-muted">@Html.DisplayFor(modelItem => item.Client.ContactDetails)</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <small>
                                        <i class="fa-solid fa-arrow-right me-2"></i>
                                        @Html.DisplayFor(modelItem => item.StartDate)<br/>
                                        <i class="fa-solid fa-arrow-left me-2"></i>
                                        @Html.DisplayFor(modelItem => item.EndDate)
                                    </small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary">@Html.DisplayFor(modelItem => item.ServiceLevel)</span>
                                </td>
                                <td class="text-center">
                                    @{
                                        var statusDisplay = item.Status switch
                                        {
                                            GLMS.Web_POE.Models.ContractStatus.Draft => (icon: "fa-file-pen", badge: "badge-secondary", label: "Draft"),
                                            GLMS.Web_POE.Models.ContractStatus.Active => (icon: "fa-check-circle", badge: "status-active", label: "Active"),
                                            GLMS.Web_POE.Models.ContractStatus.Expired => (icon: "fa-clock", badge: "status-expired", label: "Expired"),
                                            GLMS.Web_POE.Models.ContractStatus.OnHold => (icon: "fa-pause-circle", badge: "status-onhold", label: "On Hold"),
                                            _ => (icon: "fa-question-circle", badge: "badge-muted", label: "Unknown")
                                        };
                                    }
                                    <span class="badge @statusDisplay.badge">
                                        <i class="fa-solid @statusDisplay.icon me-1"></i>@statusDisplay.label
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.SignedAgreementFileName))
                                    {
                                        <a asp-action="DownloadAgreement" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Download agreement">
                                            <i class="fa-solid fa-download me-1"></i>Download
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            <i class="fa-solid fa-file-slash me-1"></i>No file
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="View contract">
                                            <i class="fa-solid fa-eye me-1"></i>View
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                            <i class="fa-solid fa-pencil me-1"></i>Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="fa-solid fa-trash me-1"></i>Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <small class="text-muted">Showing @Model.Count() contracts</small>
        <nav aria-label="Page navigation">
            <ul class="pagination mb-0">
                <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">Next</a></li>
            </ul>
        </nav>
    </div>
}
else
{
    <!-- Empty State -->
    <div class="alert alert-info border-0 py-5" role="alert">
        <div class="text-center">
            <i class="fa-solid fa-inbox fa-3x text-info mb-3 d-block"></i>
            <h4 class="mb-2">No Contracts Found</h4>
            <p class="text-muted mb-4">Start managing your freight service contracts by creating your first contract agreement.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa-solid fa-plus me-2"></i>Create Your First Contract
            </a>
        </div>
    </div>
}
