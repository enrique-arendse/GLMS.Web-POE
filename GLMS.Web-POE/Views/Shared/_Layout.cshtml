<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechMove Logistics</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-papVQmYqK1mQKk3rG2sK6j1K1n6x1qz1Qe9V7k5f3YV3KZ6a9h5o1Q==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Premium Header with Top Bar -->
    <header class="navbar-wrapper">
        <div class="navbar-topbar bg-primary text-white py-2 px-0">
            <div class="container-lg">
                <div class="row align-items-center g-0">
                    <div class="col-md-6">
                        <small class="d-flex gap-3">
                            <span><i class="fa-solid fa-phone me-1"></i>+1-800-LOGISTICS</span>
                            <span><i class="fa-solid fa-envelope me-1"></i>support@techmove.com</span>
                        </small>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <small>Global Logistics Solutions for Your Business</small>
                    </div>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm">
            <div class="container-lg">
                <a class="navbar-brand fw-bold brand-logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-truck me-2 text-primary"></i>
                    <span class="brand-text">TechMove</span>
                    <span class="brand-subtext">Logistics</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link fw-500 text-dark" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-chart-line me-1 text-primary"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-500 text-dark" asp-controller="Clients" asp-action="Index">
                                <i class="fa-solid fa-people-group me-1 text-primary"></i>Clients
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-500 text-dark" asp-controller="Contracts" asp-action="Index">
                                <i class="fa-solid fa-file-contract me-1 text-primary"></i>Contracts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-500 text-dark" asp-controller="ServiceRequests" asp-action="Index">
                                <i class="fa-solid fa-tasks me-1 text-primary"></i>Service Requests
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-500 text-dark" href="javascript:void(0);" onclick="alert('User profile section coming soon');">
                                <i class="fa-solid fa-user-circle me-1 text-primary"></i>Profile
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        <div class="container-lg py-4">
            @RenderBody()
        </div>
    </main>

    <!-- Professional Footer -->
    <footer class="footer-wrapper bg-dark text-white mt-5">
        <div class="container-lg py-5">
            <div class="row g-4 mb-4">
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">
                        <i class="fa-solid fa-truck text-primary me-2"></i>TechMove Logistics
                    </h6>
                    <p class="small text-muted">Revolutionizing global freight management with intelligent logistics coordination.</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a href="javascript:void(0);" class="text-muted text-decoration-none hover-link">Dashboard</a></li>
                        <li><a href="javascript:void(0);" class="text-muted text-decoration-none hover-link">Clients</a></li>
                        <li><a href="javascript:void(0);" class="text-muted text-decoration-none hover-link">Contracts</a></li>
                        <li><a href="javascript:void(0);" class="text-muted text-decoration-none hover-link">Service Requests</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">Support</h6>
                    <ul class="list-unstyled small">
                        <li><a href="javascript:void(0);" class="text-muted text-decoration-none hover-link">Help Center</a></li>
                        <li><a href="javascript:void(0);" class="text-muted text-decoration-none hover-link">Contact Us</a></li>
                        <li><a href="javascript:void(0);" class="text-muted text-decoration-none hover-link">Documentation</a></li>
                        <li><a href="javascript:void(0);" class="text-muted text-decoration-none hover-link">FAQs</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">Contact Info</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><i class="fa-solid fa-phone text-primary me-2"></i><a href="tel:+18008765247" class="text-muted text-decoration-none">+1-800-LOGISTICS</a></li>
                        <li class="mb-2"><i class="fa-solid fa-envelope text-primary me-2"></i><a href="mailto:support@techmove.com" class="text-muted text-decoration-none">support@techmove.com</a></li>
                        <li><i class="fa-solid fa-map-marker-alt text-primary me-2"></i>Cape Town, South Africa</li>
                    </ul>
                </div>
            </div>
            <hr class="bg-secondary">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <small class="text-muted">&copy; 2026 TechMove Logistics. All rights reserved.</small>
                </div>
                <div class="col-md-6 text-md-end">
                    <small class="text-muted">
                        <a href="javascript:void(0);" class="text-muted text-decoration-none me-3">Privacy Policy</a>
                        <a href="javascript:void(0);" class="text-muted text-decoration-none">Terms of Service</a>
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
